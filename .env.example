# CloudTruck Admin Dashboard — Environment Variables
# Copy this file to .env.local and fill in the values for your environment.

# ─── Required ─────────────────────────────────────────────────────────────────

# Backend API base URL (must include /api/v1 suffix)
# Development: http://localhost:5000/api/v1
# Production:  https://api.cloudtruck.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Backend WebSocket server URL (no path suffix)
# Development: http://localhost:5000
# Production:  https://api.cloudtruck.com
NEXT_PUBLIC_WS_URL=http://localhost:5000

# ─── Optional ─────────────────────────────────────────────────────────────────

# Google Maps JavaScript API key
# Required only for the Live Tracking Map view (/tracking/map)
# Without this key, the map view shows an error overlay; all other features work.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
